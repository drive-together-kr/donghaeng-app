# ======================================================================
#  동행(DongHaeng) 로컬 인프라 환경 변수 예시 (infra/docker-compose.yml 에서 읽음)
#
#  사용법: 이 파일을 복사해 같은 디렉터리에 .env 를 만들고 필요한 값만 바꾼다.
#          .env 는 .gitignore 에 올라 있어 커밋되지 않는다 (CLAUDE.md 규칙 9).
#  비워 두거나 .env 가 없으면 docker-compose.yml 의 기본값(${VAR:-기본값})이 쓰인다.
# ======================================================================

# ---------- PostgreSQL ----------
# ※ 아래 비밀번호들은 개발용 기본값이다. 클라우드(T32)에서는 반드시 바꾸고, 15432/6379/8083/18083 은 외부에 열지 않는다(compose 가 127.0.0.1 에만 바인딩).
POSTGRES_DB=donghaeng
POSTGRES_USER=dh
POSTGRES_PASSWORD=dh
# 호스트에 노출할 PostgreSQL 포트. 개발 PC의 로컬 PostgreSQL 18 서비스가 5432 를 점유하므로 기본값 15432.
DH_PG_HOST_PORT=15432

# ---------- EMQX ----------
# 대시보드(http://localhost:18083) admin 계정의 초기 비밀번호. 첫 로그인 시 변경을 강제한다.
EMQX_DASHBOARD_PASSWORD=public
# JWKS 재조회 주기(초). 서버가 뜬 뒤 최대 이 시간 동안은 MQTT 인증이 거부된다. 키 회전 반영 지연도 이 값.
EMQX_JWKS_REFRESH_INTERVAL=30

# ---------- 서버 공개 주소 (docs/03_API_프로토콜_명세.md 헤더) ----------
# QR·딥링크·응답 URL 을 만들 때 쓰는 공개 base URL. 끝에 / 없음. 고정 도메인을 쓰지 않는다.
#   에뮬레이터           : http://10.0.2.2:8080
#   실기기(같은 Wi-Fi)   : http://<PC-IP>:8080      (방화벽 8080/1883 인바운드 허용)
#   클라우드(T32)        : https://<VM-IP>.sslip.io
DH_PUBLIC_BASE_URL=http://10.0.2.2:8080
# 차량 앱에 내려 주는 MQTT 공개 주소.
#   에뮬레이터 tcp://10.0.2.2:1883 / 실기기 tcp://<PC-IP>:1883 / 클라우드 ssl://<VM-IP>.sslip.io:8883
DH_MQTT_PUBLIC_URI=tcp://10.0.2.2:1883

# ---------- 서버 내부 연결값 (참고용) ----------
# 아래 값은 docker-compose.yml 의 server 서비스에 컨테이너 네트워크 기준으로 고정되어 있어
# .env 에서 바꿀 필요가 없다. IDE에서 서버를 직접(호스트에서) 띄울 때는 다음 값을 쓴다.
#   SPRING_PROFILES_ACTIVE=local
#   DH_DB_URL=jdbc:postgresql://localhost:15432/donghaeng   (컨테이너 안: postgres:5432)
#   DH_DB_USER=dh
#   DH_DB_PASSWORD=dh
#   DH_REDIS_HOST=localhost                                 (컨테이너 안: redis)
#   DH_REDIS_PORT=6379
#   DH_MQTT_URI=tcp://localhost:1883                        (컨테이너 안: tcp://emqx:1883)

# ---------- JWT 서명 키 (RS256) ----------
# 서버의 RS256 개인키 (PKCS#8 PEM). 한 줄로 넣을 때는 줄바꿈을 역슬래시-n(\n) 두 글자로 적는다. 실제 값은 .env 에만 두고 커밋 금지
# (줄 끝 주석은 dotenv 파서에 따라 값에 섞일 수 있어 따로 적음). 비워 두면 서버가 기동할 때마다 개발용 키를 새로 만든다
# (재시작하면 발급된 토큰이 전부 무효 — 개발에서만 허용).
DH_JWT_PRIVATE_KEY_PEM=

# ---------- CarInfo 차량 ID 해시 salt ----------
# 서버는 차량 ID 원문을 저장하지 않고 SHA-256(차량 ID + salt) 만 둔다 (docs/04 vehicle.car_info_id_hash).
# 클라우드(T32)에서는 반드시 임의의 긴 값으로 바꾸고, 한 번 정한 뒤에는 바꾸지 않는다 (바꾸면 등록된 차량이 전부 새 차로 보인다).
DH_CAR_ID_SALT=dev-salt-change-me
