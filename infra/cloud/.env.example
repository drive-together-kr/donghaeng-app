# ======================================================================
#  동행(DongHaeng) 클라우드 VM 환경 변수 템플릿 (T32) — infra/cloud/README.md
#
#  VM 에서는 ~/donghaeng/infra/.env 로 쓴다(compose 프로젝트 디렉터리 = infra/).
#  보통은 손으로 만들지 않는다: deploy.sh → cloud/remote-env.sh 가 이 파일을 읽어
#    <IP> 를 VM 공인 IP(점 → 하이픈, 예 1-2-3-4)로 바꾸고, CHANGE_ME 를 openssl 로 만든 값으로 채운 뒤 chmod 600 으로 저장한다.
#    .env 가 이미 있으면 아무것도 하지 않는다(재실행 안전, 비밀이 바뀌지 않음).
#  .env 는 VM 에만 둔다 — 저장소·채팅·스크린샷에 올리지 않는다(CLAUDE.md 규칙 9).
#
#  값 규칙: 따옴표 없이 한 줄. 줄 끝 주석 금지(주석은 윗줄에).
#    비밀은 hex 만 쓴다 — `$` 는 compose 보간, `"`·`}` 는 EMQX HOCON(x-internal-token), 공백은 redis-server 인자를 깨뜨린다.
# ======================================================================

# ---------- 공개 주소 (docs/03 머리말, CLAUDE.md 규칙 12) ----------
# Caddy 사이트 이름 = 인증서 이름. sslip.io 가 <a-b-c-d>.sslip.io 를 a.b.c.d 로 풀어 준다(도메인 구입 불필요).
DH_PUBLIC_HOST=<IP>.sslip.io
# QR·딥링크·응답 URL 의 base. 끝에 / 없음.
DH_PUBLIC_BASE_URL=https://<IP>.sslip.io
# 차량 앱에 내려 주는 MQTT 기본 주소(Caddy layer4 가 TLS 종단 → emqx:1883).
# 대체 경로(8883 이 막힌 망): wss://<IP>.sslip.io/mqtt (443, Caddy → emqx:8083) — 앱이 DH_PUBLIC_BASE_URL 호스트에서 만든다(docs/03 머리말).
DH_MQTT_PUBLIC_URI=ssl://<IP>.sslip.io:8883
# ACME(Let's Encrypt) 계정 메일 — 선택. 비우면 메일 없이 발급. 넣으면 Caddy 가 ZeroSSL 을 예비 발급자로 붙인다.
# deploy.sh --email you@example.org 로 넘기면 remote-env.sh 가 채운다.
CADDY_EMAIL=

# ---------- PostgreSQL ----------
POSTGRES_DB=donghaeng
POSTGRES_USER=dh
# 생성: openssl rand -hex 24   (빈 pgdata 볼륨에 처음 뜰 때만 적용 — 바꾸려면 DB 안에서 ALTER USER)
POSTGRES_PASSWORD=CHANGE_ME

# ---------- Redis ----------
# requirepass. 서버는 DH_REDIS_PASSWORD 로 AUTH 한다(application.yml spring.data.redis.password).
# 생성: openssl rand -hex 24
DH_REDIS_PASSWORD=CHANGE_ME

# ---------- EMQX ----------
# 대시보드 admin 초기 비밀번호(빈 emqx-data 볼륨에 처음 뜰 때만 적용, 첫 로그인 때 변경 강제).
# 접속은 ssh -L 18083:127.0.0.1:18083 <user>@<VM-IP> 터널로만.  생성: openssl rand -hex 12
EMQX_DASHBOARD_PASSWORD=CHANGE_ME
# Erlang 분산 쿠키(기본 emqxsecretcookie 대체).  생성: openssl rand -hex 16
EMQX_NODE_COOKIE=CHANGE_ME
# JWKS 재조회 주기(초). 서버가 뜬 뒤 최대 이 시간 동안 MQTT 인증이 거부될 수 있다.
EMQX_JWKS_REFRESH_INTERVAL=30

# ---------- 서버 비밀 ----------
# EMQX ACL 훅(POST /internal/mqtt/acl) 공유 비밀 — 클라우드 필수(비우면 서버가 검사를 건너뛴다).
# 생성: openssl rand -hex 32
DH_INTERNAL_TOKEN=CHANGE_ME
# CarInfo 차량 ID 해시 salt. 한 번 정하면 바꾸지 않는다(바꾸면 등록 차량이 전부 새 차로 보인다).
# 생성: openssl rand -hex 32
DH_CAR_ID_SALT=CHANGE_ME
# RS256 개인키(PKCS#8 PEM) 한 줄 — 줄바꿈을 역슬래시-n 두 글자로 적는다(서버 JwtKeyProvider 가 되돌린다).
# 큰따옴표로 감싸지 않는다(compose 가 큰따옴표 값의 \n 을 실제 줄바꿈으로 바꿔 .env 가 깨진다).
# 생성: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'BEGIN{ORS="\\n"}{print}'
DH_JWT_PRIVATE_KEY_PEM=CHANGE_ME

# ---------- 이미지 태그 ----------
# deploy.sh 는 donghaeng/server:cloud 와 donghaeng/server:cloud-<커밋> 을 함께 올린다.
# 롤백: DH_SERVER_TAG=cloud-<이전 커밋> 으로 바꾸고 up -d server (cloud/README.md §6).
DH_SERVER_TAG=cloud
DH_CADDY_TAG=l4
