# ======================================================================
#  동행(DongHaeng) 모노레포 .gitignore
#  car-app(Android) · server(Kotlin/Spring) · phone-app(Flutter) · protocol · infra
# ======================================================================

# ---------- 비밀 값 · 서명 키 (CLAUDE.md 규칙 9: .env.example만 커밋) ----------
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pem
*.key
key.properties
keystore.properties
secrets.properties

# ---------- Android / Gradle ----------
local.properties
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof
lint-report.*
output-metadata.json
# 제출용 release APK는 apk/ 폴더에 커밋한다 (docs/11 체크리스트)
!apk/*.apk

# ---------- Kotlin / JVM (server, protocol) ----------
out/
.kotlin/
*.log
logs/
hs_err_pid*
replay_pid*

# ---------- Flutter / Dart (phone-app) ----------
.dart_tool/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
.metadata.bak
coverage/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# ---------- 인프라 로컬 데이터 (docker volume 바인드) ----------
infra/data/
infra/**/data/

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
~$*

# ---------- 제출 자료 · 개인정보 포함 파일 (CLAUDE.md 규칙 10: 블라인드 심사) ----------
# 접수양식(docx)·원본 문서 묶음(zip)에는 실명·학교·연락처가 들어가므로 어떤 docx/zip 도 올리지 않는다.
*.docx
*.zip

# ---------- Firebase 클라이언트 설정 (프로젝트 ID·API 키 포함) ----------
google-services.json
GoogleService-Info.plist
