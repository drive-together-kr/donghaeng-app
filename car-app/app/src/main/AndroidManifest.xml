<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 네트워크 (REST / MQTT) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 위치 폴백 (Android LocationManager, docs/05 §3.2 3순위) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 그룹 활성 중 포그라운드 서비스 DriveSessionService (docs/05 §6) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" /> <!-- 위치 권한 전에는 dataSync 타입으로 시작(T23) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pleos 차량 권한(pleos.car.permission.*, android.car.permission.*)은 src/pleos/AndroidManifest.xml 에만 선언 -->

    <!-- required=false 는 fake flavor 용(일반 폰·태블릿 AVD 설치). pleos flavor 는 FusedLocation AAR 이 automotive required=true 로
         병합하므로 AAOS 전용 APK 가 된다(의도된 동작, PleosFusedLocationAdapter KDoc 참조). -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".DongHaengApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DongHaeng"
        android:networkSecurityConfig="${networkSecurityConfig}"
        tools:targetApi="35">
        <!-- networkSecurityConfig: app/build.gradle.kts 의 placeholder (T32) — 빌드 기본 서버 주소가 http:// 면(로컬 개발, 10.0.2.2 / LAN PC)
             network_security_config_open(평문 전부 허용), https:// 면(클라우드) network_security_config_cloud(평문은 10.0.2.2·localhost·127.0.0.1 만 —
             숨은 메뉴로 현장 로컬 서버에 붙는 폴백, docs/10 R9). 잘못된 http 주소(오타, 서버가 준 verifyUri/invite.url, 리다이렉트)가
             평문으로 나가지 않게 막는다. 이 설정은 HiveMQ(Netty) 소켓에는 적용되지 않으므로 MqttGateway 는 서버 주소가 https 면 ssl:// · wss:// 만 허용한다.
             T29: MainActivity 에 distractionOptimized=true 를 선언한다 — 없으면 AAOS 가 속도 > 0 에서 앱 화면을 "주행 중에는 사용할 수 없습니다" 로 가린다
             (Pleos AVD 실측, docs/10 R11). 대신 앱이 스스로 CarUxRestrictionsManager(isRequiresDistractionOptimization) 를 보고 입력을 막는다(docs/05 §4). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.DongHaeng">
            <!-- 주행 중에도 표시 허용(그룹 지도·리스트 보기, 음성 안내). 입력은 DrivingStateMonitor 로 앱이 막는다 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- T23: 그룹 활성 중 포그라운드 서비스(알림만 — 수집·발행은 Application 싱글턴). 위치 권한 있으면 location, 없으면 dataSync 타입 -->
        <service
            android:name=".service.DriveSessionService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />
    </application>

</manifest>
