<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 네트워크 (REST / MQTT) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 위치 폴백 (Android LocationManager, docs/05 §3.2 3순위) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 그룹 활성 중 포그라운드 서비스 DriveSessionService (docs/05 §6) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" /> <!-- 위치 권한 전에는 dataSync 타입으로 시작(T23) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 주행 중 표면: 순정 내비 위 플로팅 패널(TYPE_APPLICATION_OVERLAY, docs/05 §5.2). Pleos 는 설정 화면이 없어
         adb 의 appops set(사용자 10) SYSTEM_ALERT_WINDOW allow 로만 허용된다(docs/10 R16). 없으면 알림 카드 + 음성 모드 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Pleos 차량 권한(pleos.car.permission.*, android.car.permission.*)은 src/pleos/AndroidManifest.xml 에만 선언 -->

    <!-- required=false 는 fake flavor 용(일반 폰·태블릿 AVD 설치). pleos flavor 는 FusedLocation AAR 이 automotive required=true 로
         병합하므로 AAOS 전용 APK 가 된다(의도된 동작, PleosFusedLocationAdapter KDoc 참조). -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- 정차 대시보드 '권한 열기' 버튼: 오버레이 권한 설정 화면이 있는 기기에서만 보이도록 resolve 확인(API 30+ 패키지 가시성).
         [내비 보기](NaviLauncher): 순정 내비 패키지 실행 인텐트·지도 앱 selector 가 어느 앱으로 풀리는지 확인 -->
    <queries>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
        </intent>
        <package android:name="ai.umos.maps.android.navigation.app" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <!-- 음성 안내(Android TextToSpeech)·무전 확인 인식(SpeechRecognizer): targetSdk 30+ 는 엔진 서비스가 보이게 선언해야 한다.
             없으면 TextToSpeech 가 엔진을 못 찾아 즉시 status=-1(2026-10-28 실측 — Pleos AVD 의 엔진 ai.pleos.playground.caas 가 있는데도 '엔진 없음'으로 보였다) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".DongHaengApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DongHaeng"
        android:usesCleartextTraffic="${usesCleartext}"
        tools:targetApi="35">
        <!-- usesCleartextTraffic: app/build.gradle.kts 의 placeholder — dhPublicBaseUrl 이 http:// 일 때(로컬 개발, 10.0.2.2 / LAN PC)만
             평문 허용; 클라우드(https) 빌드에서는 false 로 들어가 잘못된 http 주소(오타 -P 값, 서버가 준 verifyUri/invite.url, 리다이렉트)가
             평문으로 나가지 않게 막는다. 이 속성은 APK 전체에 적용되며 HiveMQ(tcp://) 소켓에는 적용되지 않으므로
             MqttGateway(T16)는 DH_PUBLIC_BASE_URL 이 https 일 때 ssl:// 만 허용한다.
             T29: MainActivity 에 distractionOptimized=true 를 선언한다 — 없으면 AAOS 가 속도 > 0 에서 앱 화면을 "주행 중에는 사용할 수 없습니다" 로 가린다
             (Pleos AVD 실측, docs/10 R11). 대신 앱이 스스로 CarUxRestrictionsManager(isRequiresDistractionOptimization) 를 보고 입력을 막는다(docs/05 §4). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.DongHaeng">
            <!-- 주행 중에도 표시 허용(그룹 지도·리스트 보기, 음성 안내). 입력은 DrivingStateMonitor 로 앱이 막는다 -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- T23: 그룹 활성 중 포그라운드 서비스(알림만 — 수집·발행은 Application 싱글턴). 위치 권한 있으면 location, 없으면 dataSync 타입 -->
        <service
            android:name=".service.DriveSessionService"
            android:exported="false"
            android:foregroundServiceType="location|dataSync" />

        <!-- 순정 내비 위 플로팅 패널(오버레이 창). DriveSurfaceController 가 그룹 + 오버레이 권한 + 동행 화면 비전면일 때만 시작 -->
        <service
            android:name=".surface.FloatingPanelService"
            android:exported="false" />
    </application>

</manifest>
