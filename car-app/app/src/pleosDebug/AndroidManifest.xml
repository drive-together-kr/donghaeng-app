<?xml version="1.0" encoding="utf-8"?>
<!-- pleos debug 빌드 전용: Pleos TextToSpeech SDK 날것 프로브(2026-10-28). 호출 방법은 PleosTtsProbe.kt 머리 주석.
     TTS_SERVICE 권한은 앱 음성 체인(PleosTtsVoiceAdapter)이 쓰므로 src/pleos/AndroidManifest.xml 로 옮겼다(R19 해결). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".adapter.voice.PleosTtsProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
