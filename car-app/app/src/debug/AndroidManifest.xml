<?xml version="1.0" encoding="utf-8"?>
<!-- debug 빌드 전용: 시연 스크립트(tools/demo)가 adb 로 앱을 조작하는 리시버. release 에는 들어가지 않는다 (T30, docs/09 §1).
     SYSTEM_ALERT_WINDOW·POST_NOTIFICATIONS 는 main 매니페스트에 있다(플로팅 패널·알림 카드 — docs/05 §5.2). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 표면 조사용 프로브(2026-10-28 실측) — 실제 패널은 main 의 surface.FloatingPanelService -->
        <service android:name=".debug.OverlayProbeService" android:exported="false" />
        <receiver
            android:name=".debug.ProbeWidgetProvider"
            android:exported="true"
            android:label="@string/probe_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/probe_widget_info" />
        </receiver>
        <!-- 호출: adb shell am broadcast -n app.donghaeng.car/.debug.DemoControlReceiver (extras: action = route_test | accept | decline | auto_follow | speak | voice | navi_route | gpx | status | open | surface | surface_pos | event …) -->
        <receiver
            android:name=".debug.DemoControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.donghaeng.car.DEMO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
