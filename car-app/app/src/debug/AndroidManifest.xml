<?xml version="1.0" encoding="utf-8"?>
<!-- debug 빌드 전용: 시연 스크립트(tools/demo)가 adb 로 앱을 조작하는 리시버. release 에는 들어가지 않는다 (T30, docs/09 §1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- 호출: adb shell am broadcast -n app.donghaeng.car/.debug.DemoControlReceiver (extras: action = route_test | accept | decline | auto_follow | speak | voice | navi_route | gpx | status) -->
        <receiver
            android:name=".debug.DemoControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.donghaeng.car.DEMO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
