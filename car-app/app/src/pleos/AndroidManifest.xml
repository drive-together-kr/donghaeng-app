<?xml version="1.0" encoding="utf-8"?>
<!-- pleos flavor 전용 매니페스트 — Pleos 차량 권한 (docs/05 §1.2, 최소 권한 원칙: 조회 권한만, CONTROL_* 없음).
     pleos.car.permission.* 와 android.car.permission.CAR_POWERTRAIN 은 normal(설치 시 자동 승인, 런타임 팝업 없음).
     android.car.permission.CAR_SPEED 는 dangerous(런타임, 그룹 '차량 정보') — Pleos AVD 에서 granted=false 로 설치됨(dumpsys 실측).
     ACCESS_FINE_LOCATION·POST_NOTIFICATIONS·(FusedLocation 사용 시) FUSED_LOCATION 과 함께 정차 상태에서 1회 요청하고(T22),
     거부 시 속도는 Haversine 계산으로 폴백한다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vehicle SDK (조회만) -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />     <!-- CarInfo: 차량 ID -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />    <!-- Brake, DrivingMode, Odometer -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />   <!-- Fuel, EvBattery -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- Light, TurnSignal -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />   <!-- Safety: 에어백 -->
    <!-- NaviHelper -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />    <!-- requestNavigationScreen (없으면 SecurityException, T20 실측) -->
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_ROUTE" />  <!-- NaviHelper 경로 커스텀 API (SDK 가 검사하는 권한명, 실측 목록) -->
    <!-- FusedLocation (오픈 시) — 런타임 권한. isSupported() 와 승인이 모두 true 일 때만 선택적으로 사용(CLAUDE.md 규칙 5, T21) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 속도·기어: AAOS 표준 Car API 시도용 (T22). CAR_SPEED 는 런타임 권한 — T22 정차 시 요청, 미승인이면 Haversine 속도. CAR_POWERTRAIN 은 normal -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <application>
        <!-- AAOS 공유 라이브러리. required=false: 없는 기기에서도 설치되고 CarApiSignals 가 "미지원" 으로 끝난다 -->
        <uses-library android:name="android.car" android:required="false" />
    </application>

</manifest>
