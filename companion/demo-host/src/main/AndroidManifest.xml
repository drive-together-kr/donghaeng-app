<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- QR 스캔(CameraX). 카메라가 없는 기기(에뮬레이터 포함)에서도 설치되도록 required=false -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- 동행 모듈(HttpDongHaengApi)·호스트의 dev 로그인(DevAuthClient)·지도 타일(osmdroid)이 네트워크를 쓴다 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 동행 그룹 이벤트를 앱이 백그라운드일 때 시스템 알림으로 (API 33+ 런타임 권한) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DemoHost"
        android:usesCleartextTraffic="${usesCleartext}">
        <!-- usesCleartextTraffic: demo-host/build.gradle.kts 의 placeholder — dhPublicBaseUrl 이 http:// 일 때(로컬 개발, 10.0.2.2)만
             평문 허용. 클라우드(https) 빌드에서는 false 로 들어가 잘못된 http 주소가 평문으로 나가지 않게 막는다(car-app 과 같은 규칙). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 메신저로 받은 초대(/j/…)·차량 등록(/pair?c=…) 주소를 누르면 이 앱으로 연다(카메라 없이 합류·등록). 서버 주소는 build.gradle.kts placeholder -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${linkScheme}" android:host="${linkHost}" android:pathPrefix="/j/" />
                <data android:scheme="${linkScheme}" android:host="${linkHost}" android:pathPrefix="/pair" />
            </intent-filter>
        </activity>
    </application>

</manifest>
