<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- QR 스캔(CameraX). 카메라가 없는 기기(에뮬레이터 포함)에서도 설치되도록 required=false -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- 동행 모듈(HttpDongHaengApi)과 호스트의 dev 로그인(DevAuthClient)이 서버와 통신한다 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DemoHost"
        android:usesCleartextTraffic="${usesCleartext}">
        <!-- usesCleartextTraffic: demo-host/build.gradle.kts 의 placeholder — dhPublicBaseUrl 이 http:// 일 때(로컬 개발, 10.0.2.2)만
             평문 허용. 클라우드(https) 빌드에서는 false 로 들어가 잘못된 http 주소가 평문으로 나가지 않게 막는다(car-app 과 같은 규칙). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
